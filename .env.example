# Public site URL used for canonical URLs, sitemap and Open Graph.
# Optional: if empty, Vercel's production domain is used, then https://theaccesspoint.com.
NEXT_PUBLIC_SITE_URL=https://theaccesspoint.com

# --- Form delivery (Web3Forms) ---
# Create a free access key at https://web3forms.com with the inbox that should receive enquiries.
# The key is public by design (it only identifies the inbox), so the NEXT_PUBLIC_ prefix is intended.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
