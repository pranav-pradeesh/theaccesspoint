# Public site URL used for canonical URLs, sitemap and Open Graph.
# Optional: if empty, Vercel's production domain is used, then https://theaccesspoint.com.
NEXT_PUBLIC_SITE_URL=https://theaccesspoint.com

# --- Lead storage (project brief submissions) ---
# Supabase: create the table in supabase/migrations/0001_leads.sql, then set both.
# The service-role key is server-only; never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: also POST every lead as JSON to a webhook (Slack workflow, Zapier, Make, CRM).
LEAD_WEBHOOK_URL=

# --- Analytics (privacy-conscious, cookieless) ---
# Plausible domain, e.g. theaccesspoint.com. Leave empty to disable analytics.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
